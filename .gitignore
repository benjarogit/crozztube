# Dependencies (reproducible via composer.lock / package-lock.json)
/vendor/
/node_modules/

# Environment & secrets
/.env
/.env.*.local
/.clip-env-*
/docker/certs/
/storage/app/license.json
/storage/app/private/
/storage/app/backups/

# Runtime state
/storage/app/plugins/
/storage/app/media-image-cache/
/storage/app/npm-cache/
/storage/app/plugin-installs/
/storage/app/installed.lock
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/*
!/storage/framework/.gitkeep
/storage/debugbar/
/uploads/*
!/uploads/.gitkeep
/bootstrap/cache/*.php

# Build/test artifacts
/tools/test/.artifacts/
/tools/test/ui/test-results/
/tools/test/ui/playwright-report/
/tools/test/ui/node_modules/
# Vite retains previous lazy chunks for open browser tabs. Only assets referenced
# by build/manifest.json are deliberately added to a release/safety commit.
/build/assets/*
# Harness receipts, verification output and downloaded tools live in .git/.
/harness/local/
.phpunit.cache/
.phpunit.result.cache
*.log
.DS_Store
/storage/app/playhub-auth.json
