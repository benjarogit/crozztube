{
  "name": "kontackt/playhub",
  "description": "PlayHub - modern Laravel 13 + React video platform starter core.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "azure-oss/storage-blob-laravel": "^2.2",
    "firebase/php-jwt": "7.1.0",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.3",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.25",
    "mews/captcha": "^3.5"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.22",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^12.0",
    "symfony/yaml": "^7.4"
  },
  "conflict": {
    "symfony/console": ">=8.0",
    "symfony/error-handler": ">=8.0",
    "symfony/http-foundation": ">=8.0",
    "symfony/http-kernel": ">=8.0",
    "symfony/mailer": ">=8.0",
    "symfony/mime": ">=8.0",
    "symfony/process": ">=8.0",
    "symfony/routing": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    },
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
