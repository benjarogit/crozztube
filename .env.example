APP_NAME=PlayHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=UTC
PLAYHUB_TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=playhub
DB_USERNAME=playhub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# Native remote push: server-only credentials outside public/; never EXPO_PUBLIC.
PLAYHUB_PUSH_ENABLED=false
PLAYHUB_PUSH_QUEUE=push
PLAYHUB_FCM_CREDENTIALS=
PLAYHUB_FCM_PACKAGES=com.playhub.mobile.dev,com.playhub.mobile.staging,net.kontackt.playhub
PLAYHUB_APNS_KEY_PATH=
PLAYHUB_APNS_KEY_ID=
PLAYHUB_APNS_TEAM_ID=
PLAYHUB_APNS_BUNDLE_ID=
PLAYHUB_APNS_BUNDLE_IDS=
DB_QUEUE_RETRY_AFTER=21660
REDIS_QUEUE_RETRY_AFTER=21660
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=null
PLAYHUB_MOBILE_TOKEN_TTL_MINUTES=43200
PLAYHUB_TV_TOKEN_TTL_MINUTES=43200
PLAYHUB_REFRESH_TOKEN_TTL_MINUTES=259200
PLAYHUB_TV_DEVICE_CODE_TTL_SECONDS=600
PLAYHUB_TV_DEVICE_POLL_INTERVAL_SECONDS=5
PLAYHUB_NATIVE_MAX_SESSIONS=10
PLAYHUB_PASSWORDLESS_DELETE_REAUTH_MINUTES=15
PLAYHUB_NATIVE_HASH_KEY=
PLAYHUB_TV_VERIFICATION_URI=https://your-domain.com/activate
PLAYHUB_NATIVE_SOCIAL_RETURN_URIS=playhub://auth/callback,playhub-development://auth/callback,playhub-staging://auth/callback
PLAYHUB_CORS_ALLOWED_ORIGINS=*
PLAYHUB_MAX_UPLOAD_MB=51200
PLAYHUB_CHUNK_SIZE_MB=8
# Command names, absolute executable paths, and FFmpeg bin directories are supported.
PLAYHUB_FFMPEG_BINARY=ffmpeg
PLAYHUB_FFPROBE_BINARY=ffprobe
PLAYHUB_ALLOW_PUBLIC_REGISTRATION=true
# Comma-separated, exact HTTPS origins that a Cast receiver can resolve and
# validate with the public Web PKI. Keep empty until production media origins
# have been verified; local .test/.local/private-IP origins are always rejected.
PLAYHUB_RECEIVER_MEDIA_ORIGINS=
PLAYHUB_RECEIVER_MIN_TTL_MINUTES=60
PLAYHUB_RECEIVER_MAX_TTL_MINUTES=1440
PLAYHUB_RECEIVER_TTL_SAFETY_MINUTES=15
PLAYHUB_PLUGINS_ENABLED=true
PLAYHUB_PLUGINS_PATH=
PLAYHUB_PLUGIN_MAX_ARCHIVE_MB=25
PLAYHUB_PLUGIN_MAX_UNCOMPRESSED_MB=100
PLAYHUB_PLUGIN_MAX_FILE_MB=20
PLAYHUB_PLUGIN_MAX_FILES=2000
PLAYHUB_UPDATES_ENABLED=true
PLAYHUB_UPDATE_ENDPOINT=https://playhub.kontackt.de/updates/latest
PLAYHUB_UPDATE_ALLOWED_HOSTS=playhub.kontackt.de
PLAYHUB_UPDATE_PUBLIC_KEY_PATH=
PLAYHUB_UPDATE_SIGNATURE_REQUIRED=true
PLAYHUB_UPDATE_REQUEST_TIMEOUT=30
PLAYHUB_UPDATE_DOWNLOAD_TIMEOUT=1800
PLAYHUB_UPDATE_MAX_PACKAGE_MB=512
PLAYHUB_UPDATE_MAX_MANIFEST_MB=16
PLAYHUB_UPDATE_MAX_UNCOMPRESSED_MB=1536
PLAYHUB_UPDATE_MAX_FILES=20000
PLAYHUB_UPDATE_BACKUP_RETENTION=5
PLAYHUB_UPDATE_STALE_AFTER_MINUTES=120
PLAYHUB_PHP_BINARY=php

LIVEKIT_URL=wss://your-domain.com/livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_KEY_FILE=/absolute/path/to/playhub/livekit/runtime/keys.yaml
LIVEKIT_RTMP_URL=rtmp://your-domain.com:1936/live
LIVEKIT_RTMP_PORT=1936
LIVEKIT_INGRESS_IMAGE=livekit/ingress:v1.5.0
LIVEKIT_REDIS_HOST=127.0.0.1
LIVEKIT_REDIS_PORT=6379
LIVEKIT_REDIS_IMAGE=redis:7.4-alpine
LIVEKIT_REDIS_USERNAME=default
LIVEKIT_REDIS_PASSWORD=
LIVEKIT_REDIS_DB=2

# Publishable KLIPY client application key; configure in Admin > Stickers instead
# if preferred. Use a non-monetized key. API/media requests originate in clients.
KLIPY_ENABLED=true
KLIPY_APP_KEY=
KLIPY_LOCALE=en_US
KLIPY_CONTENT_FILTER=high

# CrozzTube: API credentials stay local; Directupload uses its public form without a key.
CROZZTUBE_STREAMING_ONLY=true
FASTPIC_API_KEY=
POSTIMAGES_API_KEY=
THUMBNAIL_NIGHT_START=02:00
THUMBNAIL_NIGHT_END=05:00

# Oracle private clip staging only; keep the default filesystem unchanged.
# Customer Secret Key credentials, not an OCI RSA API key. Never use VITE_*.
CLIP_STAGING_OCI_REGION=eu-frankfurt-1
CLIP_STAGING_OCI_NAMESPACE=
CLIP_STAGING_OCI_BUCKET=
CLIP_STAGING_OCI_ACCESS_KEY_ID=
CLIP_STAGING_OCI_SECRET_ACCESS_KEY=

# Central Odysee publishing account. Server-side only; never use VITE_ variables.
CLIP_PUBLISH_ODYSEE_AUTH_TOKEN=
CLIP_PUBLISH_ODYSEE_CHANNEL_ID=
